# Development .dockerignore for hybrid builds
# This allows target/debug/bpfman* binaries while ignoring everything else

# Ignore Git files
.git/
.gitignore

# Ignore large directories not needed in container
libbpf/
bpfman-operator/
.output/
examples/

# Ignore most of target/ but allow debug binaries
target/release/
target/*/release/
target/*/incremental/
target/*/build/
target/*/deps/
target/*/examples/
target/*/.fingerprint/
target/debug/build/
target/debug/deps/
target/debug/examples/
target/debug/incremental/
target/debug/.fingerprint/
target/debug/.cargo-lock
target/debug/*.d
target/debug/*.rlib

# Ignore development and test artifacts
*.log
test-*.sh
*-test-*.sh
test.log
*.test
peristence.test

# Ignore development scripts and temporary files  
bpfman-dev-*.sh
create-test-container.sh
run-test-in-container.sh
clippy-doodad.sh

# Ignore IDE and development environment files
.vscode/
.direnv/
.envrc

# Ignore documentation build artifacts
.fmf/
docs/

# Ignore packaging and CI files not needed in container
packaging/
plans/
.packit*
.pre-commit-config.yaml
.github/
netlify.toml
mkdocs.yml